---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Summary from '../components/Summary.astro';
import Experience from '../components/Experience.astro';

import SideProjects from '../components/SideProjects.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import Certifications from '../components/Certifications.astro';
import Languages from '../components/Languages.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import resume from '../data/resume.json';
---

<Layout title={`${resume.basics.name} — ${resume.basics.title}`} description={resume.basics.summary}>
  <ThemeToggle />
  <Header basics={resume.basics} />
  <Summary summary={resume.basics.summary} />
  <Experience experience={resume.experience} />

  <SideProjects sideProjects={resume.sideProjects} />
  <Skills skills={resume.skills} />
  <Education education={resume.education} />
  {resume.certifications.length > 0 && <Certifications certifications={resume.certifications} />}
  <Languages languages={resume.languages} />
</Layout>
