---
interface Props {
    basics: {
        name: string;
        title: string;
        email: string;
        phone: string;
        location: string;
        website: string;
        linkedin: string;
        github: string;
    };
}

const { basics } = Astro.props;
const phoneClean = basics.phone.replace(/[\s+()-]/g, "");
---

<header
    class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4 pb-6 border-b border-[var(--color-border)] dark:border-[var(--color-border-dark)]"
>
    <div>
        <h1 class="text-3xl font-bold tracking-tight">{basics.name}</h1>
        <p
            class="text-lg text-[var(--color-muted)] dark:text-[var(--color-muted-dark)] mt-1"
        >
            {basics.title}
        </p>
    </div>
    <div
        class="text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)] space-y-1"
    >
        <!-- Email -->
        <div class="flex items-center gap-1.5">
            <a
                href={`mailto:${basics.email}`}
                target="_blank"
                rel="noopener"
                class="contact-link">{basics.email}</a
            >
            <span class="no-print flex items-center gap-0.5">
                <button
                    class="icon-btn copy-btn"
                    data-copy={basics.email}
                    aria-label="Copy email"
                    data-tooltip="Copy email"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-3.5 h-3.5"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"
                        ></path><path
                            d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"
                        ></path></svg
                    >
                </button>
            </span>
        </div>
        <!-- Phone -->
        <div class="flex items-center gap-1.5">
            <a
                href={`tel:${phoneClean}`}
                target="_blank"
                rel="noopener"
                class="contact-link">{basics.phone}</a
            >
            <span class="no-print flex items-center gap-0.5">
                <a
                    href={`https://wa.me/${phoneClean}`}
                    target="_blank"
                    rel="noopener"
                    class="icon-btn"
                    aria-label="WhatsApp"
                    data-tooltip="WhatsApp"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="w-3.5 h-3.5"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M18.497 4.409a10 10 0 0 1 -10.36 16.828l-.223 -.098l-4.759 .849l-.11 .011a1 1 0 0 1 -.11 0l-.102 -.013l-.108 -.024l-.105 -.037l-.099 -.047l-.093 -.058l-.014 -.011l-.012 -.007l-.086 -.073l-.077 -.08l-.067 -.088l-.056 -.094l-.034 -.07l-.04 -.108l-.028 -.128l-.012 -.102a1 1 0 0 1 0 -.125l.012 -.1l.024 -.11l.045 -.122l1.433 -3.304l-.009 -.014a10 10 0 0 1 1.549 -12.454l.215 -.203a10 10 0 0 1 13.226 -.217m-8.997 3.09a1.5 1.5 0 0 0 -1.5 1.5v1a6 6 0 0 0 6 6h1a1.5 1.5 0 0 0 0 -3h-1l-.144 .007a1.5 1.5 0 0 0 -1.128 .697l-.042 .074l-.022 -.007a4.01 4.01 0 0 1 -2.435 -2.435l-.008 -.023l.075 -.041a1.5 1.5 0 0 0 .704 -1.272v-1a1.5 1.5 0 0 0 -1.5 -1.5"
                        ></path></svg
                    >
                </a>
                <button
                    class="icon-btn copy-btn"
                    data-copy={basics.phone}
                    aria-label="Copy phone"
                    data-tooltip="Copy phone"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-3.5 h-3.5"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"
                        ></path><path
                            d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"
                        ></path></svg
                    >
                </button>
            </span>
        </div>
        <!-- Location -->
        <div class="flex items-center gap-1.5">
            <span>{basics.location}</span>
        </div>
        <!-- Website -->
        <div class="flex items-center gap-1.5">
            <a
                href={basics.website}
                target="_blank"
                rel="noopener"
                class="contact-link">{basics.website.replace("https://", "")}</a
            >
            <span class="no-print flex items-center gap-0.5">
                <button
                    class="icon-btn copy-btn"
                    data-copy={basics.website}
                    aria-label="Copy URL"
                    data-tooltip="Copy URL"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-3.5 h-3.5"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"
                        ></path><path
                            d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"
                        ></path></svg
                    >
                </button>
            </span>
        </div>
        <!-- LinkedIn -->
        <div class="flex items-center gap-1.5">
            <a
                href={basics.linkedin}
                target="_blank"
                rel="noopener"
                class="contact-link"
                >{
                    basics.linkedin.replace(
                        "https://linkedin.com/in/",
                        "linkedin.com/in/",
                    )
                }</a
            >
            <span class="no-print flex items-center gap-0.5">
                <button
                    class="icon-btn copy-btn"
                    data-copy={basics.linkedin}
                    aria-label="Copy LinkedIn URL"
                    data-tooltip="Copy LinkedIn URL"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-3.5 h-3.5"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"
                        ></path><path
                            d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"
                        ></path></svg
                    >
                </button>
            </span>
        </div>
        <!-- GitHub -->
        <div class="flex items-center gap-1.5">
            <a
                href={basics.github}
                target="_blank"
                rel="noopener"
                class="contact-link"
                >{
                    basics.github.replace("https://github.com/", "github.com/")
                }</a
            >
            <span class="no-print flex items-center gap-0.5">
                <button
                    class="icon-btn copy-btn"
                    data-copy={basics.github}
                    aria-label="Copy GitHub URL"
                    data-tooltip="Copy GitHub URL"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-3.5 h-3.5"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"
                        ></path><path
                            d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"
                        ></path></svg
                    >
                </button>
            </span>
        </div>
    </div>
</header>

<style>
    .contact-link {
        color: inherit;
        text-decoration: none;
        transition: text-decoration-color 0.15s;
        text-underline-offset: 2px;
    }
    .contact-link:hover {
        text-decoration: underline;
    }
    .icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 2px;
        border-radius: 3px;
        opacity: 0.5;
        transition: opacity 0.15s;
        cursor: pointer;
        background: none;
        border: none;
        color: inherit;
        position: relative;
    }
    .icon-btn:hover {
        opacity: 1;
    }
    .icon-btn[data-tooltip]::after {
        content: attr(data-tooltip);
        position: absolute;
        bottom: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        padding: 3px 8px;
        font-size: 11px;
        line-height: 1.3;
        white-space: nowrap;
        border-radius: 4px;
        background: var(--color-text);
        color: var(--color-bg);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.15s;
    }
    :global(.dark) .icon-btn[data-tooltip]::after {
        background: var(--color-text-dark);
        color: var(--color-bg-dark);
    }
    .icon-btn[data-tooltip]:hover::after {
        opacity: 1;
    }
</style>

<script>
    document.querySelectorAll(".copy-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const text = (btn as HTMLElement).dataset.copy;
            if (text) {
                await navigator.clipboard.writeText(text);
                btn.classList.add("copied");
                btn.setAttribute("data-tooltip", "Copied!");
                setTimeout(() => {
                    btn.classList.remove("copied");
                    btn.setAttribute(
                        "data-tooltip",
                        (btn as HTMLElement).getAttribute("aria-label") || "",
                    );
                }, 1500);
            }
        });
    });
</script>
