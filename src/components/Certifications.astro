---
import SectionWrapper from "./SectionWrapper.astro";
import { formatDate } from "../utils/formatDate";

interface CertItem {
    name: string;
    issuer: string;
    date: string;
}

interface Props {
    certifications: CertItem[];
}

const { certifications } = Astro.props;
---

<SectionWrapper title="Certifications">
    <div class="space-y-2">
        {
            certifications.map((cert) => (
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline">
                    <div>
                        <span class="font-semibold text-sm">{cert.name}</span>
                        <span class="text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                            {" "}
                            · {cert.issuer}
                        </span>
                    </div>
                    <span class="text-xs text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                        {formatDate(cert.date)}
                    </span>
                </div>
            ))
        }
    </div>
</SectionWrapper>
