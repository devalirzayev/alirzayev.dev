---
import SectionWrapper from "./SectionWrapper.astro";
import BulletList from "./BulletList.astro";

interface ProjectItem {
    name: string;
    url: string;
    description: string;
    highlights: string[];
}

interface Props {
    projects: ProjectItem[];
}

const { projects } = Astro.props;
---

<SectionWrapper title="Projects">
    <div class="space-y-4">
        {
            projects.map((project) => (
                <div>
                    <div class="flex items-baseline gap-2">
                        <h3 class="font-semibold text-sm">{project.name}</h3>
                        {project.url && (
                            <a
                                href={project.url}
                                class="text-xs text-[var(--color-muted)] dark:text-[var(--color-muted-dark)] hover:underline print:hidden"
                            >
                                {project.url.replace(/^https?:\/\//, "")}
                            </a>
                        )}
                    </div>
                    <p class="text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)]">
                        {project.description}
                    </p>
                    <BulletList items={project.highlights} />
                </div>
            ))
        }
    </div>
</SectionWrapper>
