---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<section class="mt-6">
  <h2 class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)] dark:text-[var(--color-muted-dark)] border-b border-[var(--color-border)] dark:border-[var(--color-border-dark)] pb-2 mb-3">Summary</h2>
  <p class="text-sm leading-relaxed">{summary}</p>
</section>
